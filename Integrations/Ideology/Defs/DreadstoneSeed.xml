<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The Dreadstone seed: a crystal hammered into the chest that grows into Dark Stone. -->

  <ThingDef ParentName="ResourceBase">
    <defName>KM_DreadstoneSeedCrystal</defName>
    <label>dreadstone seed crystal</label>
    <description>A sharp stake of Dreadstone shaped to take root in living flesh. A doctor can hammer it into a person's chest. It does not kill. It keeps the body alive while it grows through it, and leaves Dark Stone behind.</description>
    <graphicData>
      <texPath>Things/Item/Health/LumenStones/DreadstoneSeedCrystal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconPath>UI/Icons/DreadstoneSeed</uiIconPath>
    <stackLimit>10</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <statBases>
      <MarketValue>50</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <thingCategories><li>Manufactured</li></thingCategories>
    <tradeability>None</tradeability>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
  </ThingDef>

  <RecipeDef ParentName="KM_InfusionBase">
    <defName>KM_CraftDreadstoneSeedCrystal</defName>
    <label>shape dreadstone seed crystal</label>
    <description>Shape 5 Dreadstone into a dreadstone seed crystal.</description>
    <jobString>Shaping dreadstone seed crystal.</jobString>
    <targetCountAdjustment>1</targetCountAdjustment>
    <recipeUsers Inherit="False"><li>KM_SacrificialAltar</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>KM_Dreadstone</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Dreadstone</li></thingDefs></fixedIngredientFilter>
    <products><KM_DreadstoneSeedCrystal>1</KM_DreadstoneSeedCrystal></products>
    <researchPrerequisite>KM_DreadstoneSubjugation</researchPrerequisite>
  </RecipeDef>

  <!-- No medicine, no anesthetic and no removal recipe. -->
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>KM_ImplantDreadstoneSeed</defName>
    <label>hammer in dreadstone seed</label>
    <description>Drive a sharp stake of dreadstone seed crystal into the chest. It does not kill. It takes hold, keeps the body alive and starts to grow. It stays dormant until bound by Binding at a Sacrificial altar.</description>
    <jobString>hammering a dreadstone seed into TargetA's chest.</jobString>
    <workerClass>Recipe_InstallImplant</workerClass>
    <workAmount>1500</workAmount>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <skillRequirements><Medicine>5</Medicine></skillRequirements>
    <recipeUsers><li>Human</li></recipeUsers>
    <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
    <ingredients>
      <li><filter><thingDefs><li>KM_DreadstoneSeedCrystal</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_DreadstoneSeedCrystal</li></thingDefs></fixedIngredientFilter>
    <addsHediff>KM_DreadstoneSeed</addsHediff>
    <researchPrerequisite>KM_DreadstoneSubjugation</researchPrerequisite>
  </RecipeDef>

  <HediffDef>
    <defName>KM_DreadstoneSeed</defName>
    <label>dreadstone seed</label>
    <labelNoun>a dreadstone seed</labelNoun>
    <description>A stake of dreadstone buried in the chest. Once bound, it grows through the body over a few days, keeping it alive only to consume it. Nothing dulls its pain and nothing removes it. If it finishes, all that remains is Dark Stone.</description>
    <hediffClass>LumenStones.Hediff_DreadstoneSeed</hediffClass>
    <defaultLabelColor>(0.75, 0.3, 0.2)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/DreadstoneSeed</texPath></li>
    </comps>
    <!-- painOffset is the seed's own pain. Hediff_DreadstoneSeed adds it after pain factors, so nothing reduces it. -->
    <stages>
      <li>
        <label>lodged</label>
        <painOffset>0.15</painOffset>
        <extraTooltip>A stake of dreadstone is buried in the chest. It has just begun to take hold.</extraTooltip>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>rooting</label>
        <painOffset>0.35</painOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.05</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.05</offset></li>
        </capMods>
        <extraTooltip>Crystal threads have spread into the ribs and lungs. The pain grows with every hour.</extraTooltip>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>tearing</label>
        <painOffset>0.55</painOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
        </capMods>
        <extraTooltip>The crystal is growing through organs and tearing at muscle. It will not let the body fail.</extraTooltip>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>consuming</label>
        <painOffset>0.72</painOffset>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.30</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.30</offset></li>
        </capMods>
        <extraTooltip>Most of the torso is crystal now. The dreadstone keeps the pawn alive only to consume more.</extraTooltip>
      </li>
    </stages>
  </HediffDef>

  <DamageDef>
    <defName>KM_DreadstoneSeedConsumed</defName>
    <label>consumed by a dreadstone seed</label>
    <workerClass>DamageWorker</workerClass>
    <deathMessage>{0} has been consumed by a dreadstone seed.</deathMessage>
    <harmsHealth>false</harmsHealth>
    <makesBlood>false</makesBlood>
  </DamageDef>
</Defs>
