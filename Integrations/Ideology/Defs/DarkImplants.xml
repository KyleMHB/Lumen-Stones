    <fixedIngredientFilter><thingDefs><li>KM_HollowstoneArm</li></thingDefs></fixedIngredientFilter>
    <appliedOnFixedBodyParts><li>Shoulder</li></appliedOnFixedBodyParts>
    <addsHediff>KM_HollowstoneArm</addsHediff>
  </RecipeDef>

