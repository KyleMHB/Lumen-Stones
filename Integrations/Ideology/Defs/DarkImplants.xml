  <!-- Dark crystal prosthetics: stronger than light ones, each with a permanent drawback. -->

  <ThingDef ParentName="KM_CrystalProstheticItemBase">
    <defName>KM_HollowstoneArm</defName>
    <label>Hollowstone arm</label>
    <description>An arm of grown Hollowstone crystal. Once woken by Binding, it is far stronger than a natural arm and never hurts, but it dulls the pleasure of recreation.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/HollowstoneArm</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_CrystalPartHediffBase">
    <defName>KM_HollowstoneArm</defName>
    <label>Hollowstone arm</label>
    <labelNoun>a Hollowstone arm</labelNoun>
    <description>An arm of grown Hollowstone crystal. It never hurts, but it dulls the pleasure of recreation.</description>
    <spawnThingOnRemoved>KM_HollowstoneArm</spawnThingOnRemoved>
    <addedPartProps><solid>true</solid><partEfficiency>1.5</partEfficiency><betterThanNatural>true</betterThanNatural></addedPartProps>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shoulder</texPath></li>
      <li Class="HediffCompProperties_VerbGiver">
        <tools><li><label>fist</label><capacities><li>Blunt</li></capacities><power>11</power><cooldownTime>2</cooldownTime></li></tools>
      </li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Dark</side>
        <painless>true</painless>
        <drawback><statOffsets><KM_RecreationGain>-0.1</KM_RecreationGain></statOffsets></drawback>
      </li>
    </comps>
  </HediffDef>
  <RecipeDef ParentName="KM_DarkPartCraftBase">
    <defName>KM_MakeHollowstoneArm</defName>
    <label>make Hollowstone arm</label>
