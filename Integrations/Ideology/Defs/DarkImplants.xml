<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Dark implants and prosthetics share the bases in Defs/StoneImplants.xml. They are made at the Sacrificial altar and woken by Binding. -->

  <ResearchProjectDef>
    <defName>KM_DarkAttunement</defName>
    <label>Dark attunement</label>
    <description>Shape the dark stones into implants and crystal prosthetics, and wake them with Binding. Unlocks dark implant and prosthetic bills at the Sacrificial altar and the Binding ritual.</description>
    <baseCost>1500</baseCost>
    <techLevel>Neolithic</techLevel>
    <prerequisites><li>KM_WarpSacrifice</li><li>KM_LumenAttunement</li></prerequisites>
    <researchViewX>6</researchViewX>
    <researchViewY>4</researchViewY>
  </ResearchProjectDef>

  <RecipeDef Name="KM_DarkPartCraftBase" ParentName="KM_CrystalPartCraftBase" Abstract="True">
    <recipeUsers><li>KM_SacrificialAltar</li></recipeUsers>
    <researchPrerequisite>KM_DarkAttunement</researchPrerequisite>
  </RecipeDef>

  <!-- Sanguinite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_SanguiniteImplant</defName>
    <label>Sanguinite implant</label>
    <description>A shard of Sanguinite set beside the heart. Once woken by Binding, wounds bleed far less and old scars slowly heal, but the body is always hungry.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/SanguiniteImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
    <defName>KM_SanguiniteImplant</defName>
    <label>Sanguinite implant</label>
    <labelNoun>a Sanguinite implant</labelNoun>
    <description>A shard of Sanguinite beside the heart. Wounds bleed far less and old scars slowly heal, but the body is always hungry.</description>
    <spawnThingOnRemoved>KM_SanguiniteImplant</spawnThingOnRemoved>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shard</texPath></li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Dark</side>
        <benefit><totalBleedFactor>0.5</totalBleedFactor></benefit>
        <drawback><hungerRateFactor>1.4</hungerRateFactor></drawback>
      </li>
      <li Class="LumenStones.HediffCompProperties_ScarMending"><daysPerScar>5</daysPerScar></li>
    </comps>
  </HediffDef>
  <RecipeDef ParentName="KM_DarkPartCraftBase">
    <defName>KM_MakeSanguiniteImplant</defName>
    <label>make Sanguinite implant</label>
    <description>Shape Sanguinite and a component into a Sanguinite implant.</description>
    <jobString>Making Sanguinite implant.</jobString>
    <ingredients>
      <li><filter><thingDefs><li>KM_Sanguinite</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Sanguinite</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><KM_SanguiniteImplant>1</KM_SanguiniteImplant></products>
  </RecipeDef>
  <RecipeDef ParentName="KM_InstallStoneImplantBase">
    <defName>KM_InstallSanguiniteImplant</defName>
    <label>install Sanguinite implant</label>
    <description>Install a Sanguinite implant. It stays dormant until woken by Binding.</description>
    <jobString>Installing Sanguinite implant.</jobString>
    <ingredients><li><filter><thingDefs><li>KM_SanguiniteImplant</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_SanguiniteImplant</li></thingDefs></fixedIngredientFilter>
    <addsHediff>KM_SanguiniteImplant</addsHediff>
  </RecipeDef>
  <RecipeDef ParentName="KM_RemoveStoneImplantBase">
    <defName>KM_RemoveSanguiniteImplant</defName>
    <label>remove Sanguinite implant</label>
    <description>Remove a Sanguinite implant. A dormant implant comes out whole; an active one crumbles to raw Dark Stone.</description>
    <jobString>Removing Sanguinite implant.</jobString>
    <removesHediff>KM_SanguiniteImplant</removesHediff>
  </RecipeDef>

  <!-- Dreadstone implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_DreadstoneImplant</defName>
    <label>Dreadstone implant</label>
    <description>A shard of Dreadstone set beside the heart. Once woken by Binding, enemies near the bearer feel dread while the bearer is drafted or fighting, but others find the bearer cold company.</description>
