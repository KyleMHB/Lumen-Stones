  <!-- Twinstone cell: replaces the Sunstone cell with Ideology. Its Warp pool feeds dark implants and prosthetics. -->
  <ThingDef ParentName="KM_PortableCellBase">
    <defName>KM_TwinstoneCell</defName>
    <label>Twinstone cell</label>
    <description>A sealed cell of Sunstone and Bloodstone that stores Solar and Warp energy in two separate pools, for implanted pawns away from home. It charges slowly from a home settlement's spare energy, and anywhere else it relieves the drawbacks of every implanted pawn on its map or in its caravan.</description>
    <graphicData><texPath>Things/Item/Misc/TwinstoneCell</texPath></graphicData>
    <comps>
      <li Class="LumenStones.CompProperties_Twinstone"><capacity>60</capacity><warp>true</warp></li>
    </comps>
  </ThingDef>
  <RecipeDef ParentName="KM_LightPartCraftBase">
    <defName>KM_MakeTwinstoneCell</defName>
    <label>make Twinstone cell</label>
    <description>Seal Sunstone and Bloodstone into a Twinstone cell.</description>
    <jobString>Making Twinstone cell.</jobString>
    <ingredients>
      <li><filter><thingDefs><li>KM_Sunstone</li></thingDefs></filter><count>5</count></li>
      <li><filter><thingDefs><li>KM_Bloodstone</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Sunstone</li><li>KM_Bloodstone</li></thingDefs></fixedIngredientFilter>
    <products><KM_TwinstoneCell>1</KM_TwinstoneCell></products>
    <researchPrerequisites><li>KM_SunstoneChanneling</li><li>KM_WarpSacrifice</li></researchPrerequisites>
  </RecipeDef>
</Defs>
