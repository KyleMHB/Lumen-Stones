      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <KM_DarkStone>35</KM_DarkStone>
    </costList>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
