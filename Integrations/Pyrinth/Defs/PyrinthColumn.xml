<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LumenstoneColumnBase">
    <defName>KM_LumenPyrinthColumn</defName><label>pyrinth column</label><uiOrder>2042</uiOrder>
    <description>A roof-supporting Pyrinth crystal held between a broad base and capital, reinforced with a band. It is warm to the touch all year.\n\nGives off warm orange light and gentle heat without electricity or refuelling.</description>
    <statBases><MeditationFocusStrength>0</MeditationFocusStrength></statBases>
    <costList><DV_Pyrinth>15</DV_Pyrinth></costList>
    <graphicData><texPath>Lumenstone/PyrinthColumn</texPath></graphicData>
    <comps>
      <li Class="CompProperties_Glower"><glowRadius>10</glowRadius><glowColor>(192,117,77,0)</glowColor></li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass><heatPerSecond>2.5</heatPerSecond><heatPushMaxTemperature>23</heatPushMaxTemperature>
      </li>
      <li Class="LumenStones.CompProperties_FixtureEffecter"><effecterDef>DV_PyrinthSparkingEffectSmall</effecterDef></li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef><focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit"><offset>0.1</offset></li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li><li>TorchLamp</li><li>TorchWallLamp</li><li>DV_PyrinthLamp</li><li>DV_PyrinthWallLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">DV_PyrinthBrazier</li><li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
            </defs>
            <offsetPerBuilding>0.01</offsetPerBuilding><radius>9.9</radius><maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey><explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract><drawRingRadius>false</drawRingRadius>
          </li>
        </offsets>
      </li>
    </comps>
    <placeWorkers><li>PlaceWorker_Heater</li><li>PlaceWorker_MeditationOffsetBuildingsNear</li></placeWorkers>
  </ThingDef>
</Defs>
