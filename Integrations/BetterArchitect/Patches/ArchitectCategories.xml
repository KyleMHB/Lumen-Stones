<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Better Architect Menu sorts vanilla lights into Furniture > Lighting and columns into Structure > Supports.
       Every Lumen fixture that sits in Furniture gives light (lamps, wall lamps, pylons, clusters), so the
       fixture bases move as a whole. A dropdown only groups designators within one category, so all members
       of each Lumen dropdown, Pyrinth's included, must land in the same place. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="KM_LumenstoneFixtureBase" or @Name="KM_GlaciteBuildingBase" or @Name="KM_AegiteFixtureBase" or @Name="KM_FerriteFixtureBase" or @Name="KM_SereniteFixtureBase" or @Name="KM_VerditeFixtureBase" or @Name="KM_VitaliteFixtureBase" or @Name="KM_DarkStoneFixtureBase" or @Name="KM_AnimastoneFixtureBase"]/designationCategory[text()="Furniture"]</xpath>
    <value>
      <designationCategory>Ferny_Lighting</designationCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="LumenstoneColumnBase"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Supports</designationCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="KM_GlaciteCooler"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Cooling</designationCategory>
    </value>
  </Operation>

  <!-- Epochs Pyrinth fixtures that Lumen Stones adds to its dropdowns. Better Architect Menu already moves these
       when Pyrinth is active; repeat it so the result doesn't depend on which patch runs first. The Pyrinth wall
       lamp inherits its category from the lamp. -->
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="DV_PyrinthLamp" or defName="DV_PyrinthBrazier"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Lighting</designationCategory>
    </value>
  </Operation>
</Patch>
