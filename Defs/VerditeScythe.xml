<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>KM_VerditeScythe</defName>
    <label>Verdite scythe</label>
    <description>A curved peridot blade on a long dark haft. It cuts grain cleanly, and it was never meant for anything else.\n\nWhile equipped, gives +15% plant work speed and harvest yield, using the higher of this bonus and nearby Verdite fixtures rather than adding them together. Damage dealt in melee to living organic targets heals the wielder's non-permanent injuries by 3% of the actual damage after armour. Buildings, corpses and mechanical targets grant no healing. Crafted from 100 Verdite and 20 steel after Long blades, with Crafting 6.</description>
    <techLevel>Medieval</techLevel>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <relicChance>2</relicChance>
    <smeltable>false</smeltable>
    <statBases><WorkToMake>5000</WorkToMake><Mass>2</Mass></statBases>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/VerditeScythe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3875,1.3875)</drawSize>
      <!-- uiIconScale below keeps the wide horizontal art inside the build icon -->
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <weaponTags><li>MedievalMeleeAdvanced</li><li>LongSword</li></weaponTags>
    <tools>
      <li><label>handle</label><capacities><li>Blunt</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>edge</label><capacities><li>Cut</li></capacities><power>23</power><cooldownTime>2.2</cooldownTime></li>
    </tools>
    <recipeMaker>
      <unfinishedThingDef IsNull="True" />
      <researchPrerequisite>LongBlades</researchPrerequisite>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <displayPriority>422</displayPriority>
    </recipeMaker>
    <costList><KM_Verdite>100</KM_Verdite><Steel>20</Steel></costList>
  </ThingDef>
</Defs>
