      </li>
      <li Class="LumenStones.CompProperties_Serenite">
        <category>Lamp</category>
        <weight>0.1</weight>
      </li>
      <li Class="LumenStones.CompProperties_SolarToggle"><effect>sleep restoration</effect></li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="KM_SereniteFixtureBase">
    <defName>KM_SerenitePylon</defName>
    <drawerType>RealtimeOnly</drawerType>
    <label>Serenite sanctuary shrine</label>
    <uiOrder>2822</uiOrder>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <description>A low, two-cell shrine holding three refined Serenite crystals in a horned cradle. Bedrooms with one feel settled.\n\nSuited to a bedroom. Supports tranquility in an enclosed room: room support adds comfort to beds and seats and mood while present, and with Solar energy also faster sleep. Each fixture type counts once. No fuel or electricity.</description>
    <graphicData>
      <texPath>Things/Building/Serenite/Pylon</texPath>
      <drawSize>(2.2,1.2375)</drawSize>
      <drawOffset>(0,0,0.035)</drawOffset>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <stuffCategories>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <KM_Serenite>25</KM_Serenite>
    </costList>
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
      <Beauty>30</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>KM_SereniteTranquility</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(205,175,245,0)</glowColor>
      </li>
      <li Class="LumenStones.CompProperties_Serenite">
        <category>Pylon</category>
        <weight>0.45</weight>
      </li>
      <li Class="LumenStones.CompProperties_SolarToggle"><effect>sleep restoration</effect></li>
    </comps>
    <!-- Retain KM_SerenitePylon and fixture index 2 so existing shrines keep their identity and support. -->
    <size>(2,1)</size>
  </ThingDef>
