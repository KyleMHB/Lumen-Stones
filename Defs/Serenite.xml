<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>KM_Serenite</defName>
    <label>Serenite</label>
    <description>Lumenstone steeped with smokeleaf keeps the calm and leaves out the haze. Nobody hurries in a room with Serenite in it.\n\nA soft lavender crystal with a deep amethyst core, infused from Lumenstone at a Lumen ritual circle. It furnishes tranquil enclosed rooms.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Serenite</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <statBases>
      <MarketValue>9</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <allowedArchonexusCount>80</allowedArchonexusCount>
  </ThingDef>
  <ThingDef ParentName="MoteBase">
    <defName>KM_Mote_SerenitePulse</defName>
    <thingClass>MoteThrown</thingClass>
    <graphicData>
      <texPath>Things/Mote/SerenitePulse</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>0.3</solidTime>
      <fadeOutTime>0.6</fadeOutTime>
    </mote>
  </ThingDef>
  <ThingDef ParentName="LumenstoneColumnBase">
    <defName>KM_LumenSereniteColumn</defName>
    <label>Serenite column</label>
    <uiOrder>2044</uiOrder>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <description>A lavender Serenite column.\n\nSupports tranquility in an enclosed room: room support adds comfort to beds and seats and mood while present, and with Solar energy also faster sleep. Each fixture type counts once. No fuel or electricity.</description>
    <costList>
      <KM_Serenite>15</KM_Serenite>
    </costList>
    <graphicData>
      <texPath>Lumenstone/SereniteColumn</texPath>
      <drawSize>(1.1667,1.4583)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>12</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(205,175,245,0)</glowColor>
      </li>
      <li Class="LumenStones.CompProperties_Serenite">
        <category>Column</category>
        <weight>0.2</weight>
      </li>
      <li Class="LumenStones.CompProperties_SolarToggle"><effect>sleep restoration</effect></li>
    </comps>
    <uiIconScale>1.02857</uiIconScale>
  </ThingDef>
  <ThingDef Name="KM_SereniteFixtureBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <techLevel>Neolithic</techLevel>
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.15</fillPercent>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <building>
      <isInert>true</isInert>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>
  <ThingDef ParentName="KM_SereniteFixtureBase">
    <defName>KM_SereniteLamp</defName>
