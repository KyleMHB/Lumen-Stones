    <uiOrder>2803</uiOrder>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <description>A lavender Serenite lamp. Its light is low and even, and suits a bedroom.\n\nSupports tranquility in an enclosed room: room support adds comfort to beds and seats and mood while present, and with Solar energy also faster sleep. Each fixture type counts once. No fuel or electricity.</description>
    <graphicData>
      <texPath>Things/Building/Serenite/Lamp</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList>
      <WoodLog>5</WoodLog>
      <KM_Serenite>10</KM_Serenite>
    </costList>
    <statBases>
      <Beauty>8</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li><compClass>LumenStones.CompFixedMaterial</compClass></li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(205,175,245,0)</glowColor>
      </li>
      <li Class="LumenStones.CompProperties_Serenite">
        <category>Lamp</category>
        <weight>0.1</weight>
      </li>
      <li Class="LumenStones.CompProperties_SolarToggle"><effect>sleep restoration</effect></li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="KM_SereniteFixtureBase">
    <defName>KM_SereniteWallLamp</defName>
