  <ResearchProjectDef>
    <defName>KM_SereniteTranquility</defName>
    <label>Serenite tranquility</label>
    <description>Learn to infuse Lumenstone with smokeleaf, keeping its calm without its other effects.\n\nShape Serenite into soothing clusters and sanctuary shrines. Unlocks Serenite infusion at the Lumen ritual circle.</description>
    <baseCost>1200</baseCost>
    <techLevel>Neolithic</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>4</researchViewY>
    <prerequisites>
      <li>Stonecutting</li>
    </prerequisites>
  </ResearchProjectDef>
  <ThoughtDef>
    <defName>KM_SereniteRoom</defName>
    <workerClass>LumenStones.ThoughtWorker_SereniteRoom</workerClass>
    <thoughtClass>Thought_Situational</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>Serenite tranquility</label>
        <description>The lavender crystals bring a little peace to this enclosed room.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>KM_SereniteRested</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.0833333333</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Serenite-rested</label>
        <description>I woke refreshed after sleeping near soothing Serenite.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
