    <graphicData>
      <texPath>Things/Building/Lumenstone/Lamp</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <thingClass>LumenStones.Building_PlinthLamp</thingClass>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>5</costStuffCount>
    <costList>
      <KM_Lumenstone>10</KM_Lumenstone>
    </costList>
    <statBases>
      <Beauty>8</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
