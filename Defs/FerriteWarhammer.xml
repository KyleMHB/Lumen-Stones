<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>KM_FerriteWarhammer</defName>
    <label>Ferrite warhammer</label>
    <description>A slate-silver hammer with a copper crystal head. Dents in its haft and head slowly fill back in, and so do the wielder's.\n\nIts blunt melee strikes can stun living targets. While equipped, it slowly mends itself and the wielder's worn apparel and equipped weapons, at no Solar energy cost. Stronger Ferrite maintenance nearby takes priority. Crafted from 100 Ferrite and 20 steel after Long blades, with Crafting 6.</description>
    <techLevel>Medieval</techLevel>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <relicChance>2</relicChance>
    <smeltable>false</smeltable>
    <statBases><WorkToMake>5500</WorkToMake><Mass>2.5</Mass></statBases>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/FerriteWarhammer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <!-- uiIconScale below keeps the wide horizontal art inside the build icon -->
    </graphicData>
    <uiIconScale>0.75</uiIconScale>
    <weaponTags><li>MedievalMeleeAdvanced</li></weaponTags>
    <tools>
      <li><label>handle</label><capacities><li>Blunt</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>head</label><capacities><li>Blunt</li></capacities><power>24</power><cooldownTime>2.6</cooldownTime></li>
    </tools>
    <recipeMaker>
      <unfinishedThingDef IsNull="True" />
      <researchPrerequisite>LongBlades</researchPrerequisite>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <displayPriority>423</displayPriority>
    </recipeMaker>
    <costList><KM_Ferrite>100</KM_Ferrite><Steel>20</Steel></costList>
    <comps><li Class="LumenStones.CompProperties_Ferrite"><personal>true</personal><tier>0</tier><radius>0</radius><interval>300</interval><repairBudget>0.000225</repairBudget></li></comps>
  </ThingDef>
</Defs>
