<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Shared base for every stone implant and crystal prosthetic. Light content lives here; dark content is in Integrations/Ideology. -->

  <ResearchProjectDef>
    <defName>KM_LumenAttunement</defName>
    <label>Lumen attunement</label>
    <description>Shape infused Lumenstone into implants and crystal prosthetics, and wake them with Attunement. Unlocks light implant and prosthetic bills at the Lumen ritual circle, the Attunement ritual and, without Ideology, the attunement job at the circle.</description>
    <baseCost>1500</baseCost>
    <techLevel>Neolithic</techLevel>
    <prerequisites><li>KM_VitaliteRestoration</li></prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>7</researchViewY>
  </ResearchProjectDef>

  <StatDef>
    <defName>KM_RecreationGain</defName>
    <label>recreation gain</label>
    <description>A multiplier on how much recreation a person gains from any source.</description>
    <category>PawnMisc</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>1</defaultBaseValue>
    <hideAtValue>1</hideAtValue>
    <minValue>0</minValue>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnDrones>false</showOnDrones>
  </StatDef>

  <HediffDef>
    <defName>KM_AttunementSickness</defName>
    <label>attunement sickness</label>
    <description>A newly woken crystal is settling into the body. It aches and slows the step for about a day.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.7, 1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Icons/AttunementSickness</texPath></li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.1</painOffset>
        <capMods><li><capacity>Moving</capacity><offset>-0.15</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>

  <JobDef>
    <defName>KM_AttuneAtCircle</defName>
    <driverClass>LumenStones.JobDriver_AttuneAtCircle</driverClass>
    <reportString>attuning TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Items -->

  <ThingDef Name="KM_CrystalPartItemBase" ParentName="BodyPartBase" Abstract="True">
    <techLevel>Neolithic</techLevel>
    <thingCategories><li>BodyPartsProsthetic</li></thingCategories>
    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <tradeability>Sellable</tradeability>
  </ThingDef>

  <ThingDef Name="KM_StoneImplantItemBase" ParentName="KM_CrystalPartItemBase" Abstract="True">
    <statBases>
      <MarketValue>350</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <modExtensions><li Class="LumenStones.CrystalPartItem" /></modExtensions>
  </ThingDef>

  <ThingDef Name="KM_CrystalProstheticItemBase" ParentName="KM_CrystalPartItemBase" Abstract="True">
    <statBases>
      <MarketValue>450</MarketValue>
      <Mass>2</Mass>
    </statBases>
    <modExtensions><li Class="LumenStones.CrystalPartItem"><prosthetic>true</prosthetic></li></modExtensions>
  </ThingDef>

  <!-- Bills. Light bills are worked at the circle; an Ideology patch adds the Lumenstone altar. -->

  <RecipeDef Name="KM_CrystalPartCraftBase" Abstract="True">
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <skillRequirements><Crafting>5</Crafting></skillRequirements>
    <researchPrerequisite>KM_LumenAttunement</researchPrerequisite>
  </RecipeDef>

  <RecipeDef Name="KM_LightPartCraftBase" ParentName="KM_CrystalPartCraftBase" Abstract="True">
    <recipeUsers><li>KM_LumenCircle</li></recipeUsers>
  </RecipeDef>

  <!-- Hediffs and surgery -->

  <HediffDef Name="KM_StoneImplantHediffBase" ParentName="ImplantHediffBase" Abstract="True">
    <hediffClass>LumenStones.Hediff_StoneImplant</hediffClass>
    <defaultLabelColor>(0.75, 0.65, 1.0)</defaultLabelColor>
  </HediffDef>

  <HediffDef Name="KM_CrystalPartHediffBase" ParentName="AddedBodyPartBase" Abstract="True">
    <hediffClass>LumenStones.Hediff_CrystalPart</hediffClass>
    <defaultLabelColor>(0.75, 0.65, 1.0)</defaultLabelColor>
  </HediffDef>

  <RecipeDef Name="KM_InstallStoneImplantBase" ParentName="SurgeryInstallImplantBase" Abstract="True">
    <workerClass>LumenStones.Recipe_InstallStoneImplant</workerClass>
    <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef Name="KM_RemoveStoneImplantBase" ParentName="SurgeryRemoveImplantBase" Abstract="True">
    <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef Name="KM_InstallCrystalPartBase" ParentName="SurgeryInstallBodyPartArtificialBase" Abstract="True" />

  <!-- Glacite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_GlaciteImplant</defName>
    <label>Glacite implant</label>
    <description>A shard of Glacite set beside the heart. Once woken by Attunement, it keeps the body comfortable in great heat but makes cold harder to bear.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/GlaciteImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
    <defName>KM_GlaciteImplant</defName>
    <label>Glacite implant</label>
    <labelNoun>a Glacite implant</labelNoun>
    <description>A shard of Glacite beside the heart. It keeps the body comfortable in great heat but makes cold harder to bear.</description>
    <spawnThingOnRemoved>KM_GlaciteImplant</spawnThingOnRemoved>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shard</texPath></li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Light</side>
        <benefit><statOffsets><ComfyTemperatureMax>30</ComfyTemperatureMax></statOffsets></benefit>
        <drawback><statOffsets><ComfyTemperatureMin>20</ComfyTemperatureMin></statOffsets></drawback>
      </li>
    </comps>
  </HediffDef>
  <RecipeDef ParentName="KM_LightPartCraftBase">
    <defName>KM_MakeGlaciteImplant</defName>
    <label>make Glacite implant</label>
    <description>Shape Glacite and a component into a Glacite implant.</description>
    <jobString>Making Glacite implant.</jobString>
    <ingredients>
      <li><filter><thingDefs><li>KM_Glacite</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Glacite</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><KM_GlaciteImplant>1</KM_GlaciteImplant></products>
  </RecipeDef>
  <RecipeDef ParentName="KM_InstallStoneImplantBase">
    <defName>KM_InstallGlaciteImplant</defName>
    <label>install Glacite implant</label>
    <description>Install a Glacite implant. It stays dormant until woken by Attunement.</description>
    <jobString>Installing Glacite implant.</jobString>
    <ingredients><li><filter><thingDefs><li>KM_GlaciteImplant</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_GlaciteImplant</li></thingDefs></fixedIngredientFilter>
    <addsHediff>KM_GlaciteImplant</addsHediff>
  </RecipeDef>
  <RecipeDef ParentName="KM_RemoveStoneImplantBase">
    <defName>KM_RemoveGlaciteImplant</defName>
    <label>remove Glacite implant</label>
    <description>Remove a Glacite implant. A dormant implant comes out whole; an active one crumbles to raw Lumenstone.</description>
    <jobString>Removing Glacite implant.</jobString>
    <removesHediff>KM_GlaciteImplant</removesHediff>
  </RecipeDef>

  <!-- Verdite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_VerditeImplant</defName>
    <label>Verdite implant</label>
    <description>A shard of Verdite set beside the stomach. Once woken by Attunement, it stores sunlight and feeds the body with it, so the bearer needs less food. A bearer kept from the sun for too long grows hungrier than normal.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/VerditeImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
    <defName>KM_VerditeImplant</defName>
    <label>Verdite implant</label>
    <labelNoun>a Verdite implant</labelNoun>
    <description>A shard of Verdite beside the stomach. It stores sunlight in a reserve that feeds the body. Time in the sun fills it; time without sun drains it.</description>
    <spawnThingOnRemoved>KM_VerditeImplant</spawnThingOnRemoved>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shard</texPath></li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Light</side>
        <reserve>KM_SunlightReserve</reserve>
      </li>
    </comps>
  </HediffDef>
  <!-- Severity is the stored sunlight. Stages are ordered low to high; the lowest is the drawback that Solar energy relieves. -->
  <HediffDef>
    <defName>KM_SunlightReserve</defName>
    <label>sunlight reserve</label>
    <description>Sunlight stored in a Verdite implant. Clear sun fills it in a few hours, rain and fog more slowly, and Verdite overlight at half speed. Without sun it drains over about a day and a half.</description>
    <hediffClass>LumenStones.Hediff_SunlightReserve</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>sun-starved</label>
        <hungerRateFactor>1.3</hungerRateFactor>
        <extraTooltip>The crystal has gone dark. The body is hungry for light.</extraTooltip>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>fading</label>
        <hungerRateFactor>0.85</hungerRateFactor>
        <extraTooltip>The stored light is running low.</extraTooltip>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>sun-fed</label>
        <hungerRateFactor>0.6</hungerRateFactor>
        <extraTooltip>Sunlight stored in the Verdite crystal is feeding the body.</extraTooltip>
      </li>
    </stages>
    <modExtensions>
      <li Class="LumenStones.SunlightReserveExtension">
        <hoursToFill>4</hoursToFill>
        <daysToDrain>1.5</daysToDrain>
        <startSeverity>0.5</startSeverity>
        <overlightRate>0.5</overlightRate>
      </li>
    </modExtensions>
  </HediffDef>
  <RecipeDef ParentName="KM_LightPartCraftBase">
    <defName>KM_MakeVerditeImplant</defName>
    <label>make Verdite implant</label>
    <description>Shape Verdite and a component into a Verdite implant.</description>
    <jobString>Making Verdite implant.</jobString>
    <ingredients>
      <li><filter><thingDefs><li>KM_Verdite</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Verdite</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><KM_VerditeImplant>1</KM_VerditeImplant></products>
  </RecipeDef>
  <RecipeDef ParentName="KM_InstallStoneImplantBase">
    <defName>KM_InstallVerditeImplant</defName>
    <label>install Verdite implant</label>
    <description>Install a Verdite implant. It stays dormant until woken by Attunement.</description>
    <jobString>Installing Verdite implant.</jobString>
    <ingredients><li><filter><thingDefs><li>KM_VerditeImplant</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_VerditeImplant</li></thingDefs></fixedIngredientFilter>
    <addsHediff>KM_VerditeImplant</addsHediff>
  </RecipeDef>
  <RecipeDef ParentName="KM_RemoveStoneImplantBase">
    <defName>KM_RemoveVerditeImplant</defName>
    <label>remove Verdite implant</label>
    <description>Remove a Verdite implant. A dormant implant comes out whole; an active one crumbles to raw Lumenstone.</description>
    <jobString>Removing Verdite implant.</jobString>
    <removesHediff>KM_VerditeImplant</removesHediff>
  </RecipeDef>

  <!-- Vitalite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_VitaliteImplant</defName>
    <label>Vitalite implant</label>
    <description>A shard of Vitalite set beside the heart. Once woken by Attunement, wounds heal faster and disease is fought off sooner, but the body turns its strength away from bearing children. Without Biotech, it tires the body instead.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/VitaliteImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
    <defName>KM_VitaliteImplant</defName>
    <label>Vitalite implant</label>
    <labelNoun>a Vitalite implant</labelNoun>
    <description>A shard of Vitalite beside the heart. Wounds heal faster and disease is fought off sooner, at the cost of fertility. Without Biotech, it tires the body instead.</description>
    <spawnThingOnRemoved>KM_VitaliteImplant</spawnThingOnRemoved>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shard</texPath></li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Light</side>
        <benefit><statFactors><InjuryHealingFactor>1.5</InjuryHealingFactor><ImmunityGainSpeed>1.2</ImmunityGainSpeed></statFactors></benefit>
        <sterile>true</sterile>
        <drawbackWithoutBiotech><restFallFactor>1.2</restFallFactor></drawbackWithoutBiotech>
      </li>
    </comps>
  </HediffDef>
  <RecipeDef ParentName="KM_LightPartCraftBase">
    <defName>KM_MakeVitaliteImplant</defName>
    <label>make Vitalite implant</label>
    <description>Shape Vitalite and a component into a Vitalite implant.</description>
    <jobString>Making Vitalite implant.</jobString>
    <ingredients>
      <li><filter><thingDefs><li>KM_Vitalite</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_Vitalite</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><KM_VitaliteImplant>1</KM_VitaliteImplant></products>
  </RecipeDef>
  <RecipeDef ParentName="KM_InstallStoneImplantBase">
    <defName>KM_InstallVitaliteImplant</defName>
    <label>install Vitalite implant</label>
    <description>Install a Vitalite implant. It stays dormant until woken by Attunement.</description>
    <jobString>Installing Vitalite implant.</jobString>
    <ingredients><li><filter><thingDefs><li>KM_VitaliteImplant</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>KM_VitaliteImplant</li></thingDefs></fixedIngredientFilter>
    <addsHediff>KM_VitaliteImplant</addsHediff>
  </RecipeDef>
  <RecipeDef ParentName="KM_RemoveStoneImplantBase">
    <defName>KM_RemoveVitaliteImplant</defName>
    <label>remove Vitalite implant</label>
    <description>Remove a Vitalite implant. A dormant implant comes out whole; an active one crumbles to raw Lumenstone.</description>
    <jobString>Removing Vitalite implant.</jobString>
    <removesHediff>KM_VitaliteImplant</removesHediff>
  </RecipeDef>

  <!-- Serenite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_SereniteImplant</defName>
    <label>Serenite implant</label>
    <description>A shard of Serenite set beside the heart. Once woken by Attunement, it steadies the mind and lifts the mood, but slows the body and its work.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/SereniteImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
    <defName>KM_SereniteImplant</defName>
    <label>Serenite implant</label>
    <labelNoun>a Serenite implant</labelNoun>
    <description>A shard of Serenite beside the heart. It steadies the mind and lifts the mood, but slows the body and its work.</description>
    <spawnThingOnRemoved>KM_SereniteImplant</spawnThingOnRemoved>
    <comps>
      <li Class="LumenStones.HediffCompProperties_StateIcon"><texPath>UI/Health/LumenStones/Shard</texPath></li>
      <li Class="LumenStones.HediffCompProperties_Attunement">
        <side>Light</side>
        <benefit><statOffsets><MentalBreakThreshold>-0.08</MentalBreakThreshold></statOffsets></benefit>
        <drawback>
          <statOffsets><WorkSpeedGlobal>-0.1</WorkSpeedGlobal></statOffsets>
          <capMods><li><capacity>Moving</capacity><offset>-0.1</offset></li></capMods>
        </drawback>
      </li>
    </comps>
  </HediffDef>
  <ThoughtDef>
    <defName>KM_SereniteImplantCalm</defName>
    <workerClass>LumenStones.ThoughtWorker_StoneImplant</workerClass>
    <thoughtClass>LumenStones.Thought_StoneImplant</thoughtClass>
    <hediff>KM_SereniteImplant</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>Serenite calm</label>
        <description>A quiet light sits beside my heart.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <RecipeDef ParentName="KM_LightPartCraftBase">
    <defName>KM_MakeSereniteImplant</defName>
    <label>make Serenite implant</label>
    <description>Shape Serenite and a component into a Serenite implant.</description>
