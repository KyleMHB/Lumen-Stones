  <!-- Aegite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_AegiteImplant</defName>
    <label>Aegite implant</label>
    <description>A shard of Aegite set beside the heart. Once woken by Attunement, the body barely burns, shrugs off food poisoning and resists toxins, but tires faster.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/AegiteImplant</texPath><color>(255,255,255)</color></graphicData>
  </ThingDef>
  <HediffDef ParentName="KM_StoneImplantHediffBase">
