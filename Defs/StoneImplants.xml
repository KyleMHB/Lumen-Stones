  <!-- Portable cells. Without Ideology the Sunstone cell carries Solar energy only. With Ideology the Twinstone cell
       (Integrations/Ideology) adds a Warp pool and replaces the Sunstone cell's bill. -->

  <ThingDef Name="KM_PortableCellBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Never</tickerType>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <stackLimit>1</stackLimit>
    <techLevel>Neolithic</techLevel>
    <thingCategories><li>Items</li></thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>300</MarketValue>
      <Mass>1</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

