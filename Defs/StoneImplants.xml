  </RecipeDef>

  <!-- Ferrite implant -->

  <ThingDef ParentName="KM_StoneImplantItemBase">
    <defName>KM_FerriteImplant</defName>
    <label>Ferrite implant</label>
    <description>A shard of Ferrite set beside the spine. Once woken by Attunement, the skin hardens against blades and blows and worn apparel slowly mends, but the body moves heavily.</description>
    <graphicData><texPath>Things/Item/Health/LumenStones/FerriteImplant</texPath><color>(255,255,255)</color></graphicData>
