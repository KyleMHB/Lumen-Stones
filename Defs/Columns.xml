<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="LumenstoneColumnBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <designationCategory>Structure</designationCategory>
    <uiIconScale>1.2</uiIconScale>
    <!-- ponytail: fixed priority also covers foreground trees; position-based occlusion needs a separate rendering change. -->
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.25</fillPercent>
    <pathCost>0</pathCost>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints><WorkToBuild>750</WorkToBuild>
      <Mass>10</Mass><Flammability>1</Flammability><Beauty>5</Beauty>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
    </statBases>
    <stuffCategories><li>Metallic</li><li>Woody</li><li>Stony</li></stuffCategories>
    <costStuffCount>20</costStuffCount>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>false</canOverlapZones><rotatable>false</rotatable><fertility>0</fertility>
    <specialDisplayRadius>6.9</specialDisplayRadius>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <building><isInert>true</isInert><ai_chillDestination>false</ai_chillDestination><paintable>true</paintable></building>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1.25)</drawSize><drawOffset>(0,0,0.2)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(255,255,255,255)</colorTwo>
      <shadowData><volume>(0.3,0.5,0.3)</volume><offset>(0,0,-0.23)</offset></shadowData>
    </graphicData>
    <comps><li Class="CompProperties_Styleable" /></comps>
    <placeWorkers><li>PlaceWorker_GlowRadius</li></placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
  </ThingDef>
  <ThingDef ParentName="LumenstoneColumnBase">
    <defName>KM_LumenFireflyColumn</defName><label>firefly column</label><uiOrder>2041</uiOrder>
    <description>A roof support with a sheltered firefly colony living inside it.\n\nGives off soft green light without heat, electricity or refuelling. Requires a jar of fireflies.</description>
    <tickerType>Never</tickerType>
    <costList><KM_LumenFireflyJar>1</KM_LumenFireflyJar></costList>
    <graphicData>
      <texPath>Lumenstone/FireflyColumn</texPath>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower"><glowRadius>10</glowRadius><glowColor>(155,225,100,0)</glowColor></li>
      <li Class="LumenStones.CompProperties_Fireflies"><column>true</column></li>
    </comps>
  </ThingDef>
</Defs>
