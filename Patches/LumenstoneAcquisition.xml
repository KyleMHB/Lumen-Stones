<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/MapGeneratorDef[@Name="MapCommonBase"]/genSteps</xpath>
    <value><li>KM_LumenstoneSurface</li></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Base_Outlander_Standard" or defName="Base_Neolithic_Standard" or defName="Caravan_Neolithic_ShamanMerchant" or defName="Caravan_Outlander_BulkGoods" or defName="Caravan_Outlander_Exotic" or defName="Orbital_BulkGoods" or defName="Orbital_Exotic"]/stockGenerators</xpath>
    <value><li Class="LumenStones.StockGenerator_Lumenstone"><countRange>5~20</countRange><price>Exorbitant</price></li></value>
  </Operation>
  <!-- Odyssey's mineral-rich tiles pick from every resource rock regardless of commonality. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TileMutatorDef[defName="MineralRich"]/resourceBlacklist</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="MineralRich"]/resourceBlacklist</xpath>
      <value><li>KM_MineableLumenstone</li></value>
    </match>
  </Operation>
</Patch>
